### Create a department
POST http://localhost:8080/departments
Content-Type: application/json

{
  "name": "Mamocentrum 2"
}

### Get departments
GET http://localhost:8080/departments

### Delete a department
DELETE http://localhost:8080/departments/1

### Create a consult type
POST http://localhost:8080/consult-types
Content-Type: application/json

{
  "consultType": "Mamografie",
  "durationMinutes": 15
}

### Get consult types
GET http://localhost:8080/consult-types

### Delete a consult type
DELETE http://localhost:8080/consult-types/1

### Get all day templates
GET http://localhost:8080/day-templates

### Get day templates for specific department
GET http://localhost:8080/day-templates?department-id=2

### Create a day template
POST http://localhost:8080/day-templates
Content-Type: application/json

{
  "name": "Pondelok 2",
  "departmentId": 3
}

### Get day template consults
GET http://localhost:8080/day-templates/2/consults

### Create day template consults
POST http://localhost:8080/day-templates/2/consults
Content-Type: application/json

[
  {
    "consultTypeId": 3,
    "dayTemplateId": 2,
    "time": "9:00",
    "note": "Nerezervovat"
  },
  {
    "consultTypeId": 3,
    "dayTemplateId": 2,
    "time": "10:00"
  }
]

### Create a consult
POST http://localhost:8080/departments/2/consults
Content-Type: application/json

{
  "departmentId": 2,
  "time": "2025-07-28T8:00"
}

### Get consults for day
GET http://localhost:8080/departments/2/consults?day=2025-07-28

### Delete a consult
DELETE http://localhost:8080/departments/2/consults/4

### Update a consult
POST http://localhost:8080/departments/2/consults/1
Content-Type: application/json

{
  "departmentId": 2,
  "time": "2025-07-28T11:00"
}
